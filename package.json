{
  "name": "robert",
  "version": "0.1.0",
  "description": "A Telegram group assistant that listens to everything, speaks when asked, and runs any OpenRouter model.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "robert": "./bin/robert.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node bin/robert.ts setup",
    "start": "node bin/robert.ts start",
    "doctor": "node bin/robert.ts doctor",
    "status": "node bin/robert.ts status",
    "update": "node bin/robert.ts update",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "grammy": "^1.46.0",
    "qrcode-terminal": "^0.12.0",
    "quickjs-emscripten-core": "^0.32.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  }
}
