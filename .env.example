# Copy to .env (or let `robert setup` write ~/.robert/.env for you). Never commit real values.
OPENROUTER_API_KEY=sk-or-v1-...
TELEGRAM_BOT_TOKEN=123456789:AA...
# Optional: Telegram user id of the owner (setup normally records this in config.json)
# ROBERT_OWNER_ID=123456789
# Optional: where Robert keeps its config, database and media (default ~/.robert)
# ROBERT_HOME=/var/lib/robert
